@startuml "[Activity] VITA Reserve - Screen Client"
skinparam ConditionEndStyle hline
title "[Activity] Screen Client"

|Client or\nSched. Part.|
start
:<b>Client Input Steps:</b>
* Enter Income
* Enter Age
* Diclose Disability
* Choose Language;
note right
    **JSON Payload**
    <font:monospaced>
    {
        "income": 12000,
        "age": 45,
        "disability": false,
        "non-english": "en"
    }
end note
:Submit for automatic review;

|System|
floating note right
    **Built hashmap on backend**
    <font:monospaced>
    criteria = {
        "income": false,
        "age": false,
        "disability": false,
        "non-english": false
    }
end note
if (Income < x) then (Yes)
    :Set income to True;
else (No)
    :Set income to False;
endif

if (Age >= x) then (Yes)
    :Set age to True;
else (No)
    :Set age to False;
endif

if (Disability Disclosed) then (Yes)
    :Set disability to True;
else (No)
    :Set disability to False;
endif

if (Language not English) then (Yes)
    :Set Non-English to True;
else (No)
    :Set Non-English to False;
endif

if (Is any Critera set to True) then (Yes)
    :Prepare Approval;
else (No)
    :Prepare Deny;
endif

:Send Eligiblity Status;

|Client or\nSched. Part.|
if (Approved) then (Yes)
    :Allow continue to\nscheduling appointment.;
else (No)
    :Alert client/sched. part. that\nthe client is not approved.;
endif

end
footer Sched. Part. = Scheduling Partner
@enduml