@startuml
title "System View: VITA Reserve System"

!$NEW_C4_STYLE=1
!include <C4/C4_Context>

Person(client, Client, "Completes screening, viewing, and scheduling appointments.")
Person(scheduling_partner, "Scheduling Partner", "Assists clients in screening, viewing, and scheduling.")
Person(site_coordinator, "Site Coordinator", "Manages timeblocks, view scheduled appointments, and cancel appointments.")

System(vita_reserve_system, "VITA Reservation System", "System allowing clients & scheduling partners to view screen, view, and scheduling. Also allowing Site Coordinators to manage time blocks, view scheduled appointments, and cancel.")
System_Ext(oauth_login, "OAuth Login Provider", "Login provider API will interact w/ to authenticate Site Coordinators.")

Rel(client, vita_reserve_system, "Screening, Viewing, or Scheduling.")
Rel_R(scheduling_partner, vita_reserve_system, "Screening, Viewing, or Scheduling.")
Rel_L(site_coordinator, vita_reserve_system, "Manage Timeblocks, Viewing or Cancelling Appointments.")

Rel_D(vita_reserve_system, oauth_login, "Authenticates users")

SHOW_LEGEND()
@enduml