@startuml "vita-reserve_use-cases"
title "VITA Reserve - Use Cases"
left to right direction
actor "Client" as ct
actor "Scheduling\nPartner" as sp
actor "Site\nCoordinator" as sc

rectangle "VITA Reserve System" {
    usecase "Screen the Client" as UC1
    usecase "View Available Appointments" as UC2
    usecase "Schedule Appointment" as UC3
    usecase "Cancel Appointment" as UC4
    usecase "View/Export Scheduled Appointments" as UC5
    usecase "Manage Capacity" as UC6
}

ct -- UC1
sp -- UC1 #line:red;

ct -- UC2
sp -- UC2 #line:red;

ct -- UC3
sp -- UC3 #line:red;

ct -- UC4
sp -- UC4 #line:red;

UC5 -- sc
UC6 -- sc

@enduml