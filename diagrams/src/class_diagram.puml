@startuml
title "Class Diagram: VITA Reserve System"

class Client {
    - id: UUID
    - first_name: String
    - last_name: String
    - phone_number: String
    - zip_code: String

    + Client(): Client
    + get_first_name(): String
    + get_last_name(): String
    + get_name(): String
    + get_phone_number(): String
    + get_zip_code(): String
    + matches_household(): Boolean
}

class Household {
    - last_name: String
    - phone_number: String
    - zip_code: String

    + Household(): Household
}

class Appointment {
    - id: UUID
    - tax_year: Integer
    - status: StatusEnum
    - household: Household
    
    + Appointment(): Appointment
    + get_id(): UUID
    + get_tax_year(): Integer
    + is_upcoming(): Boolean
    + get_household(): Household
}

enum StatusEnum {
    CANCELLED
    UPCOMING
}
note left {
    Used to determine if an 
    appointmnet has been cancelled 
    or not.
}

class TimeBlock {
    - start_time: Time
    - end_time: Time
    - day_of_week: DayEnum

    + TimeBlock(): TimeBlock
    + get_start_time(): Time
    + get_end_time(): Time
    + get_day_of_week(): DayEnum
}

enum DayEnum {
    SUNDAY
    MONDAY
    TUESDAY
    WEDNESDAY
    THURSDAY
    FRIDAY
    SATURDAY
}
note left {
    Will be used as a 
    bitwise flag for coorelating 
    multiple days it reoccurs.
}

class Location {
    - id: UUID
    - name: String
    - capacity: Integer

    + Location(): Location
    + get_id(): UUID
    + get_name(): String
    + get_capacity(): Integer
}

class Exception {
    - id: UUID
    - day: Date
    - start_time: Time
    - end_time: Time
    - is_closed: Boolean
    - capacity: Integer
}

class AppointmentHandler {}
class AvailabilityHandler {}
class ScreenHandler {}
class LocationHandler {}

Appointment -left-- StatusEnum
TimeBlock -left-- DayEnum

Client ||--|| Household
Household ||--|{ Appointment
Appointment ||--|| Location
Location ||--o{ TimeBlock
Location ||-left-o{ Exception

Client }o-right-|| ScreenHandler
Appointment }o-right-|| AppointmentHandler
Location }o-right-|| LocationHandler
Location }o-right-|| AvailabilityHandler



@enduml